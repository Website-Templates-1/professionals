{
  "name": "vite-mintek",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-google-reviews.mjs && node scripts/validate-blog.mjs && node scripts/validate-related.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-llms.mjs",
    "build": "vite-react-ssg build",
    "reviews": "node scripts/fetch-google-reviews.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "llms": "node scripts/generate-llms.mjs",
    "validate:blog": "node scripts/validate-blog.mjs",
    "validate:related": "node scripts/validate-related.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.45.6",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.10",
    "@mui/material": "^5.15.10",
    "@mui/utils": "^5.17.1",
    "js-yaml": "^5.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.1",
    "remark-gfm": "^4.0.1",
    "vite-react-ssg": "^0.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/react": "^18.2.55",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^17.11.0",
    "vite": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  },
  "browserslist": [
    "chrome >= 87",
    "edge >= 88",
    "firefox >= 78",
    "safari >= 14"
  ]
}
