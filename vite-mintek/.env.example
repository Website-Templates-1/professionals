# Contact form → email-service (public, build-time values; safe to ship).
# Copy to .env and fill in. The formId comes from the email-service:
#   npm run create-form -- --project "<project>" --to "you@minteksoftware.com" --name "Mintek contact" --origins "https://minteksoftware.com,https://www.minteksoftware.com"
VITE_EMAIL_SERVICE_URL=http://localhost:4100
VITE_CONTACT_FORM_ID=frm_xxxxxxxx

# "Scope your site" tool → design-preview previews (mockup-scope Worker in the
# local-lead-finder repo). Optional: if unset, the result screen simply omits
# the design directions. e.g. https://mockup-scope.<your-subdomain>.workers.dev
VITE_SCOPE_PREVIEW_BASE=

# Google reviews → fetched at BUILD TIME by scripts/fetch-google-reviews.mjs for
# the Place ID in siteConfig (site.placeId) and baked into the static pages.
# SERVER-SIDE ONLY: not VITE_ prefixed, so it is never exposed in the client
# bundle. Needs a Google Cloud project with the "Places API (New)" enabled and
# billing on. If unset, the build keeps the committed src/content/google-reviews.js.
GOOGLE_PLACES_API_KEY=
